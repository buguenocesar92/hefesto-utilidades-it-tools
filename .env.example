# Copiar a .env y completar. NUNCA versionar el .env real.
# BASIC_AUTH_USER: usuario del gateway Caddy.
# BASIC_AUTH_HASH: hash BCRYPT (no la contrasena en claro).
#   Generar: docker run --rm httpd:2.4-alpine htpasswd -nbB hefesto | tr -d '\n'
# El valor de ejemplo REEMPLAZAR_HASH_BCRYPT es RECHAZADO por scripts/configure.py:
# con el, el acceso al gateway queda con una credencial conocida.
BASIC_AUTH_USER=hefesto
BASIC_AUTH_HASH='REEMPLAZAR_HASH_BCRYPT'

# Clave PUBLICA age del receptor de los respaldos. Es un insumo externo:
# la define el custodio del respaldo (Infisical, Vaultwarden o sobre cifrado).
# Sin ella el respaldo sale sin el .env y el manifiesto lo declara.
#   Generar el par: age-keygen -o clave.txt  (la publica esta en el encabezado)
AGE_RECIPIENT=
